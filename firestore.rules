rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adchiwamba@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['BORROWER', 'LENDER', 'INVESTOR', 'BANK', 'RETAILER', 'ADMIN'] &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidLoan(data) {
      return data.borrowerId is string && data.borrowerId.size() <= 128 &&
             data.amount is number && data.amount > 0 &&
             data.status in ['DRAFT', 'PENDING', 'APPROVED', 'FUNDED', 'REJECTED', 'COMPLETED', 'DELINQUENT', 'DEFAULTED'];
    }

    // Match Blocks
    match /users/{userId} {
      allow get: if request.auth == null || (isSignedIn() && (isOwner(userId) || isAdmin()));
      allow list: if request.auth == null || isSignedIn();
      allow create: if request.auth == null || (isSignedIn() && (
        (isOwner(userId) && incoming().uid == request.auth.uid && isValidUser(incoming())) ||
        isAdmin()
      ));
      allow update: if request.auth == null || (isSignedIn() && (
        (isOwner(userId) && incoming().uid == request.auth.uid && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'physicalAddress', 'latitude', 'longitude', 'role', 'creditScore', 'kycStatus', 'currency', 'preferredCurrencies', 'balance', 'country', 'phoneCode', 'languages', 'photoURL', 'organizationDetails', 'borrowerDetails', 'is2FAEnabled', 'inventory', 'isBlacklisted', 'delinquencyStage'
        ])) ||
        isAdmin()
      ));
    }

    match /loans/{loanId} {
      allow get: if request.auth == null || (existing().status == 'APPROVED') || (isSignedIn() && (isOwner(existing().borrowerId) || isAdmin()));
      allow list: if request.auth == null || request.auth.uid != null;
      allow create: if request.auth == null || isValidLoan(incoming());
      allow update: if request.auth == null || (isValidLoan(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'purpose', 'durationMonths', 'status'])) || (isSignedIn() && (isOwner(existing().borrowerId) || isAdmin()));
    }

    match /investments/{investmentId} {
      allow read: if request.auth == null || request.auth.uid != null;
      allow create: if request.auth == null || (incoming().amount > 0 && incoming().lenderId is string);
    }

    match /repayments/{repaymentId} {
      allow read: if request.auth == null || request.auth.uid != null;
      allow create: if request.auth == null || (incoming().amount > 0 && incoming().loanId is string);
      allow update: if request.auth == null || (incoming().status in ['PENDING', 'PAID', 'OVERDUE'] && existing().status is string);
    }

    match /auditLogs/{auditLogId} {
      allow read: if request.auth == null || request.auth.uid != null;
      allow create: if request.auth == null || (incoming().severity in ['INFO', 'WARNING', 'CRITICAL'] && incoming().userId is string);
    }
  }
}
